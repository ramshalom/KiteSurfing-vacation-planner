# Rename this file to ".env" and fill in your real keys.

# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Get a free key from https://serper.dev (used for live web search)
SERPER_API_KEY=your_serper_api_key_here

# Which Claude model the agents use. Sonnet 5 is the recommended default.
CREW_MODEL=anthropic/claude-sonnet-5
